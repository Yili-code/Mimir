# Never commit real values. GitHub deployment uses repository secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
MIMIR_OWNER_PROFILE=
MIMIR_OWNER_PROFILE_VERSION=owner-v1

# Optional
FIRESTORE_DATABASE=(default)
GEMINI_MODEL=gemini-3.8-flash
MIMIR_MAX_CASES_PER_RUN=5
MIMIR_MAX_CLAIMS=5
MIMIR_MAX_SOURCES=8
MIMIR_MAX_FAILURE_ATTEMPTS=4
